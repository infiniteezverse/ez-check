{
  "name": "ez-check",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces --if-present && vitest run --dir test",
    "server": "npm run dev -w @ezcheck/approval-server",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@ezcheck/mcp-sdk": "0.1.0",
    "@simplewebauthn/server": "^14.0.3",
    "@simplewebauthn/browser": "^14.0.0"
  }
}
